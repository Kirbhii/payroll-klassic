# Copy to .env.local for local development, and set the same two values in
# Vercel (Settings → Environment Variables) for the deployed build.
#
# Both are safe to expose to the browser. The service-role key is NOT used by
# this app and must never be added here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
